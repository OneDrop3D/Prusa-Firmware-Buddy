#: tmp_error_headers/error_list.hpp:317
msgid ""
"The tool is not picked up. Make sure it is seated in its dock, then retry."
msgstr ""
"Lo strumento non viene prelevato. Assicurati che sia correttamente inserito "
"nel suo dock, quindi riprova."

